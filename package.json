{
  "name": "bookmation",
  "displayName": "Bookmation",
  "version": "0.0.1",
  "description": "Chrome拡張機能専用のブックマークを、カテゴリ／タグと検索で見つけ直す",
  "author": "Bookmation",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:idb": "vitest run src/adapters/indexeddb/local-data-layer.test.ts",
    "test:idb:watch": "vitest src/adapters/indexeddb/local-data-layer.test.ts",
    "ui:preview": "vite --config vite.preview.config.mjs",
    "ui:build": "vite build --config vite.preview.config.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "idb": "^8.0.3",
    "plasmo": "0.90.5",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/chrome": "0.1.4",
    "@types/node": "22.17.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@unicode/unicode-15.1.0": "^1.6.17",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "manifest": {
    "permissions": [
      "storage",
      "activeTab",
      "contextMenus",
      "history",
      "alarms"
    ],
    "optional_permissions": [
      "notifications"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "commands": {
      "save-current-page": {
        "description": "現在のページをブックマーク"
      },
      "open-bookmation-home": {
        "description": "Bookmation ホームを開く"
      }
    }
  }
}
