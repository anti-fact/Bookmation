{
  "name": "bookmation",
  "displayName": "Bookmation",
  "version": "0.0.1",
  "description": "Chrome拡張機能専用のブックマークを、カテゴリ／タグと検索で見つけ直す",
  "author": "Bookmation",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/chrome": "0.1.4",
    "@types/node": "22.17.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4"
  },
  "manifest": {
    "permissions": [
      "storage",
      "activeTab"
    ]
  }
}
